{
  "name": "onesmallclick",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/build-pages.mjs && vite",
    "build": "node scripts/build-pages.mjs && tsc -b && vite build",
    "preview": "npm run build && vite preview",
    "pages": "node scripts/build-pages.mjs",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc -b",
    "cf-typegen": "wrangler types worker/worker-configuration.d.ts"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.70.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "wrangler": "^4.164.0"
  },
  "allowScripts": {
    "workerd@1.20261116.1": true,
    "workerd@1.20261117.1": true,
    "esbuild@0.28.2": true
  }
}
