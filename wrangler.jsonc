{
  // Worker name (lowercase, hyphens).
  "name": "onesmallclick",
  // The date this project started.
  "compatibility_date": "2026-11-18",
  // The Worker. It only answers /api/*; everything else is the React app's static files.
  "main": "./worker/index.ts",
  "assets": {
    // The Cloudflare Vite plugin fills in the directory (Vite's build output) at build time.
    // Unknown paths such as /kit get index.html, and the app picks the page.
    "not_found_handling": "single-page-application",
    // Phase S1: crew links (/c/<code>) and the content pages people share get their link previews from the Worker.
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/c/*", "/milestones/*", "/destinations/*", "/how-to-play"]
  },
  "observability": { "enabled": true },

  // Phase 4: the shared probe. One Durable Object (SQLite-backed) holds the live distance;
  // every browser opens a WebSocket to it through /api/probe.
  "durable_objects": {
    "bindings": [{ "name": "PROBE", "class_name": "Probe" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Probe"] }],

  // Phase 4: devices, missions and km per day. Schema in migrations/.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "onesmallclick",
      "database_id": "a772545d-83b9-4468-8b63-7691b9359dd4",
      "migrations_dir": "migrations"
    }
  ],

  // Where the game lives, for the links in the Discord posts (and later the notifications). Change it when the domain moves.
  "vars": { "SITE_URL": "https://onesmallclick.naveessharma.workers.dev" }

  // Secrets (not in this file): ADMIN_KEY, DEVICE_SECRET, TURNSTILE_SECRET, GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET and (phase Q1b) DISCORD_WEBHOOK_URL.
  // Email sign-in (worker/email.ts) also needs, once onesmallclick.io is in Email Service and on Workers Paid:
  //   "send_email": [{ "name": "EMAIL" }]  and  "EMAIL_FROM": "signin@onesmallclick.io" in "vars"
  // Production: npx wrangler secret put <NAME>. Local: .dev.vars (git-ignored).
}
