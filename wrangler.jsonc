{
  // Worker name (lowercase, hyphens).
  "name": "onesmallclick",
  // The date this project started.
  "compatibility_date": "2026-11-18",
  // The Worker. It only answers /api/*; everything else is the React app's static files.
  "main": "./worker/index.ts",
  "assets": {
    // The Cloudflare Vite plugin fills in the directory (Vite's build output) at build time.
    // Unknown paths such as /kit get index.html, and the app picks the page.
    "not_found_handling": "single-page-application",
    // Phase S1: crew links (/c/<code>) and the content pages people share get their link previews from the Worker.
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/c/*", "/milestones/*", "/destinations/*", "/how-to-play"]
  },
  "observability": { "enabled": true },

  // Phase 4: the shared probe. One Durable Object (SQLite-backed) holds the live distance;
  // every browser opens a WebSocket to it through /api/probe.
  "durable_objects": {
    "bindings": [{ "name": "PROBE", "class_name": "Probe" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Probe"] }],

  // Phase 4: devices, missions and km per day. Schema in migrations/.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "onesmallclick",
      "database_id": "a772545d-83b9-4468-8b63-7691b9359dd4",
      "migrations_dir": "migrations"
    }
  ],

  // Phase A1b: save states (decision 35). Created by Claude 2026-11-26 (prompt 124), free tier.
  // Lifecycle rule 'expire-players': everything under players/ is deleted after 90 days (the privacy page's promise).
  "r2_buckets": [{ "binding": "SNAPSHOTS", "bucket_name": "onesmallclick-snapshots" }],
  // Phase A1b-2: the daily save states at 00:05 UTC (players, and from A1c-1 the game's); A1c-1: the game's hourly one.
  "triggers": { "crons": ["5 0 * * *", "0 * * * *"] },
  // Phase A1c-1: the deployed version's id, so the Probe takes a game save state the first time it starts on new code.
  "version_metadata": { "binding": "CF_VERSION_METADATA" },

  // Where the game lives, for the links in the Discord posts (and later the notifications). Change it when the domain moves.
  "vars": {
    "SITE_URL": "https://onesmallclick.naveessharma.workers.dev",
    // Phase Q1b-2: the public half of the push key pair (scripts/make-vapid.mjs); the private half is the secret VAPID_PRIVATE_KEY.
    "VAPID_PUBLIC_KEY": "BLctcGySbY5seen9ohufA34rSq7p8Zvclw0PFRYrLAv1JJFT2IMQ8GnM4YkxLllcQfPjaQqI--0rAMOGWEUkN70"
  }

  // Secrets (not in this file): ADMIN_KEY, DEVICE_SECRET, TURNSTILE_SECRET, GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET and (phase Q1b) DISCORD_WEBHOOK_URL and VAPID_PRIVATE_KEY.
  // Email sign-in (worker/email.ts) also needs, once onesmallclick.io is in Email Service and on Workers Paid:
  //   "send_email": [{ "name": "EMAIL" }]  and  "EMAIL_FROM": "signin@onesmallclick.io" in "vars"
  // Production: npx wrangler secret put <NAME>. Local: .dev.vars (git-ignored).
}
